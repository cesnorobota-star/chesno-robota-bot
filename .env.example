# ===== Meta / Threads =====
THREADS_APP_ID=
THREADS_APP_SECRET=
# Має точно збігатися з адресою в налаштуваннях застосунку (Redirect Callback URLs)
THREADS_REDIRECT_URI=https://example.com/threads-callback

# ===== Автопостинг =====
TIMEZONE=Europe/Kyiv
POST_QUEUE=posts_queue.csv
# Слоти публікацій (київський час). Кожен пост отримає випадковий зсув ±POST_JITTER_MINUTES
POST_SLOTS=08:30,12:30,17:00,20:30
POST_JITTER_MINUTES=15
MIN_GAP_MINUTES=90
MAX_POSTS_PER_DAY=5
# 1 = замінювати довгі тире (-) на короткі (-) перед публікацією
NORMALIZE_DASHES=1
# Через скільки хвилин після поста виходить авторська відповідь (колонка self_reply), діапазон
SELF_REPLY_DELAY_MINUTES=3-10

# ===== Коментарі (ШІ) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
BRAND_NAME=Чесно Робота
COMMENT_KEYWORDS=відгуки про роботу,відгук про роботодавця,співбесіда,роботодавець,звільнився,перша робота,пошук роботи,тестове завдання,HR,зарплата
SEARCH_DAYS=3
SEARCH_LIMIT_PER_KEYWORD=15
MAX_COMMENTS_PER_HOUR=4
MAX_COMMENTS_PER_DAY=15
COMMENT_DELAY_MIN_SECONDS=240
COMMENT_DELAY_MAX_SECONDS=600
